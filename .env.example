# Flask Configuration
FLASK_APP=app.py
FLASK_ENV=development
SECRET_KEY=replace-with-a-random-secret-at-least-32-characters
ADMIN_PASSWORD=replace-with-a-unique-password-at-least-16-characters
DATABASE_PATH=database/campus_express.db

# Microsoft Foundry / Azure OpenAI Service Configuration
# Obtain these from your Microsoft Foundry (ai.azure.com) Project Deployments
AZURE_OPENAI_API_KEY=your_azure_foundry_api_key_here
AZURE_OPENAI_ENDPOINT=https://your-foundry-endpoint.openai.azure.com/
AZURE_OPENAI_DEPLOYMENT=gpt-4o-mini
AZURE_OPENAI_API_VERSION=2024-08-01-preview

# Optional Direct OpenAI / Compatible Endpoint (alternative to Azure endpoint)
OPENAI_API_KEY=
OPENAI_BASE_URL=

# Fallback Mode: 'auto' will automatically simulate intelligent grounded responses
# if Azure Foundry credentials are not configured or offline. Set to 'strict' to require Azure.
AI_FALLBACK_MODE=auto
